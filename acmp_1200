#include <iostream>
#include <string>

using namespace std;

int main()
{
    int n;
    cin >> n;
    //cin.get();
    cin.ignore();
    for(int k = 0;k < n;k++){
        string str;
        string ans = " ";
        getline(cin,str);
       
       
       
        for(int i = str.size();i >= -1;i--){
           
            if(i == -1 || str[i] == ' '){
               
                for(int j = i + 1;j < str.size();j++){
                   
                    if(j == str.size() || str[j] == ' '){
                        break;
                    }
                    cout << str[j];
                }
                cout << " ";
            }
        }
        
        cout << '\n';
       
    }
   

    return 0;
}
